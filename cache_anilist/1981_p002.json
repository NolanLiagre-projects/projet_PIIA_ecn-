month": null}, "endDate": {"year": 1981, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 21, "countryOfOrigin": "JP", "source": "OTHER", "hashtag": null, "genres": ["Adventure"], "tags": []}, {"id": 113848, "title": {"romaji": "Shiroi Zou", "english": "White Elephant"}, "format": "MOVIE", "description": "A Tadanari Okamoto film about the White Elephant story which originated in Southeast Asia.", "startDate": {"year": 1981, "month": null}, "endDate": {"year": 1981, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 22, "countryOfOrigin": "JP", "source": "OTHER", "hashtag": null, "genres": ["Action"], "tags": [{"name": "Stop Motion", "rank": 20, "isAdult": false}]}, {"id": 128021, "title": {"romaji": "Kaibutsu-kun: Kaibutsu Land e no Shoutai", "english": null}, "format": "MOVIE", "description": "Based on the shounen manga by Fujiko Fujio. \n<br><br>\n<i>Note: Screened as a double feature with Doraemon: Nobita no Uchuu Kaitakushi.</i>", "startDate": {"year": 1981, "month": 3}, "endDate": {"year": 1981, "month": 3}, "season": "SPRING", "seasonYear": 1981, "episodes": 1, "duration": 75, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Adventure"], "tags": []}, {"id": 129871, "title": {"romaji": "Eomma Chaja Sammanli", "english": null}, "format": "MOVIE", "description": null, "startDate": {"year": 1981, "month": 1}, "endDate": {"year": 1981, "month": 1}, "season": null, "seasonYear": null, "episodes": 1, "duration": 78, "countryOfOrigin": "KR", "source": "NOVEL", "hashtag": null, "genres": ["Adventure", "Drama"], "tags": []}, {"id": 138728, "title": {"romaji": "Lao Shan Daoshi", "english": null}, "format": "MOVIE", "description": null, "startDate": {"year": 1981, "month": null}, "endDate": {"year": 1981, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 26, "countryOfOrigin": "CN", "source": "OTHER", "hashtag": null, "genres": [], "tags": [{"name": "Stop Motion"