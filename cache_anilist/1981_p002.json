s": []}, {"id": 18303, "title": {"romaji": "Sonyeon 007 Jihajeguk", "english": null}, "format": "MOVIE", "description": "A 1981 movie from 007 franchise.", "startDate": {"year": 1981, "month": null}, "endDate": {"year": 1981, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 70, "countryOfOrigin": "KR", "source": null, "hashtag": null, "genres": ["Action", "Adventure", "Sci-Fi"], "tags": []}, {"id": 18759, "title": {"romaji": "Captain Gekijouban", "english": null}, "format": "MOVIE", "description": "The movie focuses on a game between Sumiya 2 and Aoba Gakuin.", "startDate": {"year": 1981, "month": 7}, "endDate": {"year": 1981, "month": 7}, "season": "SUMMER", "seasonYear": 1981, "episodes": 1, "duration": 98, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Sports"], "tags": [{"name": "Shounen", "rank": 79, "isAdult": false}, {"name": "Primarily Male Cast", "rank": 60, "isAdult": false}, {"name": "Baseball", "rank": 60, "isAdult": false}]}, {"id": 19177, "title": {"romaji": "Chiisana Love Letter: Mariko to Nemunoki no Kodomo-tachi", "english": null}, "format": "SPECIAL", "description": "A follow-up to the same studio's Helen Keller anime, A Little Love Letter kept the handicapped theme but focused on a wholly Japanese story. During the 1970s, actress Mariko Miyagi became heavily involved in the Silk Tree Academy (Nemunoki Gakuen), a rehabilitation center for disabled children. She appeared in several live-action films to promote the project, including The Silk Tree Ballad, Mariko-Mother, and Children Drawing Rainbows. This anime charts the 14-year period of Miyagi's stewardship of the academy and her relationships with several of the children. Divided into four seasonal chapters, the film uses highly realistic character designs based on the actual people involved and features storyboarding from the versatile Star Blazers-director Noboru Ishiguro.<br><br>\n(Source: AnimeVice)", "startDate": {"year": 1981, "month": 12}, "endDate": {"year": 1981, "month": 12}, "season": "FALL", "seasonYear": 1981, "episodes": 1, "duration": 84, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": ["Drama", "Music"], "tags": [{"name": "School", "rank": 50, "isAdult": false}, {"name": "Kids", "rank": 50, "isAdult": false}]}, {"id": 20093, "title": {"romaji": "Furiten-kun", "english": null}, "format": "MOVIE", "description": "Based on the yonkoma manga by Ueda Masashi.", "startDate": {"year": 1981, "month": 4}, "endDate": {"year": 1981, "month": 4}, "season": "SPRING", "seasonYear": 1981, "episodes": 1, "duration": 75, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Comedy", "Slice of Life"], "tags": [{"name": "Mahjong", "rank": 79, "isAdult": false}, {"name": "Seinen", "rank": 50, "isAdult": false}]}, {"id": 20109, "title": {"romaji": "Bokura Mangaka: Tokiwasou Monogatari", "english": null}, "format": "SPECIAL", "description": "Tokiwa was the apartment complex where a group of stellar artists lived in 1953. <br><br>\nHiro Terada, Motoo Abiko and Hiroshi Fujimoto, Shotaro Ishinomori and Fujio Akatsuka shared the trials and tribulations of being struggling young artists and writers with no money and no luck with editors or girls, with a spirit of insane youthful enthusiasm that enabled them to survive the lean years and emerge as stars of the manga firmament.<br><br>\n(Source: AniDB)", "startDate": {"year": 1981, "month": 10}, "endDate": {"year": 1981, "month": 10}, "season": "FALL", "seasonYear": 1981, "episodes": 1, "duration": 72, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": ["Comedy", "Slice of Life"], "tags": []}, {"id": 20241, "title": {"romaji": "Manga Hana no Kakarichou", "english": null}, "format": "MOVIE", "description": "Based on the comedy manga by Sonoyama Shunji.", "startDate": {"year": 1981, "month": 11}, "endDate": {"year": 1981, "month": 11}, "season": "FALL", "seasonYear": 1981, "episodes": 1, "duration": 60, "country