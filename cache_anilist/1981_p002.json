{"data": {"Page": {"pageInfo": {"currentPage": 2, "hasNextPage": false}, "media": [{"id": 10236, "title": {"romaji": "Kagee Grimm Douwa", "english": null}, "format": "TV_SHORT", "description": null, "startDate": {"year": 1980, "month": null}, "endDate": {"year": 1981, "month": null}, "season": null, "seasonYear": null, "episodes": 52, "duration": 10, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": ["Adventure"], "tags": []}, {"id": 10755, "title": {"romaji": "Lupin tai Holmes", "english": null}, "format": "SPECIAL", "description": "Based on a story by Maurice Leblanc.", "startDate": {"year": 1981, "month": 5}, "endDate": {"year": 1981, "month": 5}, "season": "SPRING", "seasonYear": 1981, "episodes": 1, "duration": 65, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": ["Mystery"], "tags": []}, {"id": 11625, "title": {"romaji": "Donbe Monogatari", "english": null}, "format": "SPECIAL", "description": "Researcher Mutsugoro takes his family to a remote and uninhabited island near Hokkaido, to study the local population of wild bears. Nearby poachers make his life difficult, and he \"inherits\" an orphaned bear cub, whom the family call Donbe and raise as one of their own.", "startDate": {"year": 1981, "month": 4}, "endDate": {"year": 1981, "month": 4}, "season": "SPRING", "seasonYear": 1981, "episodes": 1, "duration": 90, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": [], "tags": [{"name": "Animals", "rank": 79, "isAdult": false}, {"name": "Kids", "rank": 50, "isAdult": false}]}, {"id": 12091, "title": {"romaji": "X Bomber", "english": "Star Fleet"}, "format": "TV", "description": "In the last years of the third millennium, the solar system is recovering from a devastating interplanetary war. Suddenly, a new enemy arrives in the solar system, intent on destruction and conquest. Against them stands the Earth Defense Force and its top secret X Project.\n<br><br>\n(Source: Anime News Network)", "startDate": {"year"