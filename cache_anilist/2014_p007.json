{"data": {"Page": {"pageInfo": {"currentPage": 7, "hasNextPage": true}, "media": [{"id": 20757, "title": {"romaji": "Girlfriend (Kari)", "english": "Girl Friend BETA"}, "format": "TV", "description": "Shiina Kokomi is a hard working but even tempered high school girl who is the lead performer in her school's rhythmic gymnastics club. The story follows her and her growing circle of friends as they support each other through the various trials and situations that comprise high school life.\n<br><br>\n(Source: Anime News Network)", "startDate": {"year": 2014, "month": 10}, "endDate": {"year": 2014, "month": 12}, "season": "FALL", "seasonYear": 2014, "episodes": 12, "duration": 24, "countryOfOrigin": "JP", "source": "VIDEO_GAME", "hashtag": null, "genres": ["Slice of Life"], "tags": [{"name": "Cute Girls Doing Cute Things", "rank": 84, "isAdult": false}, {"name": "Primarily Female Cast", "rank": 80, "isAdult": false}, {"name": "School", "rank": 79, "isAdult": false}, {"name": "Female Protagonist", "rank": 79, "isAdult": false}, {"name": "Vocal Synth", "rank": 70, "isAdult": false}, {"name": "School Club", "rank": 66, "isAdult": false}, {"name": "Ensemble Cast", "rank": 60, "isAdult": false}]}, {"id": 20759, "title": {"romaji": "Gatchaman Crowds: Embrace", "english": null}, "format": "SPECIAL", "description": "Director's cut of episode 12 included with the BD/DVD box release. Contains about 15 minutes of new content.", "startDate": {"year": 2014, "month": 1}, "endDate": {"year": 2014, "month": 1}, "season": "WINTER", "seasonYear": 2014, "episodes": 1, "duration": 23, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Adventure", "Sci-Fi"], "tags": [{"name": "Aliens", "rank": 79, "isAdult": false}, {"name": "Tokusatsu", "rank": 73, "isAdult": false}, {"name": "Henshin", "rank": 70, "isAdult": false}, {"name": "Super Power", "rank": 70, "isAdult": false}, {"name": "Crossdressing", "rank": 26, "isAdult": false}, {"name": "Kuudere", "rank": 20, "isAd