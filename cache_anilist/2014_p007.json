, "endDate": {"year": 2014, "month": 12}, "season": "SUMMER", "seasonYear": 2014, "episodes": 3, "duration": 5, "countryOfOrigin": "JP", "source": "OTHER", "hashtag": null, "genres": ["Comedy"], "tags": [{"name": "Chibi", "rank": 79, "isAdult": false}, {"name": "Parody", "rank": 60, "isAdult": false}, {"name": "Fishing", "rank": 40, "isAdult": false}, {"name": "Meta", "rank": 20, "isAdult": false}, {"name": "Kuudere", "rank": 20, "isAdult": false}]}, {"id": 20878, "title": {"romaji": "Meitantei Conan: Edogawa Conan Shissou Jiken - Shijou Saiaku no Futsukakan", "english": "The Disappearance of Conan Edogawa: The Worst Two Days in History"}, "format": "SPECIAL", "description": "It's been announced that a new Detective Conan anime special project is launching. The \"astonishing collaboration\" is titled \"Edogawa Conan Shissou Jiken: Shijou Saiaku no Futsukakan\" (The Disappearance of Conan Edogawa: The Worst Two Days in History).<br>\r\n<br>\r\nThe anime special will celebrate the 20th anniversary of Gosho Aoyama's original manga, and it will recount a previously untold story from Conan's past.\n<br><br>\n(Source: Anime News Network)", "startDate": {"year": 2014, "month": 12}, "endDate": {"year": 2014, "month": 12}, "season": "FALL", "seasonYear": 2014, "episodes": 1, "duration": 91, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Adventure", "Comedy", "Mystery"], "tags": [{"name": "Age Regression", "rank": 100, "isAdult": false}, {"name": "Police", "rank": 79, "isAdult": false}, {"name": "Shounen", "rank": 79, "isAdult": false}, {"name": "Male Protagonist", "rank": 79, "isAdult": false}, {"name": "Detective", "rank": 73, "isAdult": false}]}, {"id": 20882, "title": {"romaji": "Gintama': Futon ni Haitte kara Buki Nokoshi ni Kizuite Neru ni Nerenai Toki mo Aru", "english": null}, "format": "SPECIAL", "description": "A special episode that was previewed at a screening at Jump Special Anime Festa 2014. \nThe tagline for the anime reads, \"It's time for all the Yorozuya members ...to wake up just one more time.\"\n<br><br>\n<i>Note: On April 3, 2015, it was bundled with a limited edition of the manga's 58th volume. </i>", "startDate": {"year": 2014, "month": 11}, "endDate": {"year": 2014, "month": 11}, "season": "FALL", "seasonYear": 2014, "episodes": 1, "duration": 25, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Action", "Comedy", "Sci-Fi"], "tags": [{"name": "Parody", "rank": 79, "isAdult": false}, {"name": "Shounen", "rank": 79, "isAdult": false}, {"name": "Memory Manipulation", "rank": 79, "isAdult": false}, {"name": "Ghost", "rank": 79, "isAdult": false}, {"name": "Swordplay", "rank": 20, "isAdult": false}, {"name": "Historical", "rank": 20, "isAdult": false}]}, {"id": 20884, "title": {"romaji": "Haikyuu!!: Lev Kenzan!", "english": "HAIKYU!!: Lev Appears!"}, "format": "OVA", "description": "The event anime will tell an original story that reveals \"a surprising side of a popular player.\"<br></br>\n\nLev Haiba is determined to become Nekoma High's ace volleyball player, but can barely hit the ball. The team's coach orders Kenma Kozume to help out Lev with his practice, much to the former's annoyance. However, as they continue to work together, Kenma realizes that Lev's height might actually be able to help in games if his skills are honed in the right way.\n<br></br>\n(Source: Anime News Network, edited)\n<br><br>\n<i>Note: The OVA was screened at Jump Festa 2014 on November 9, 2014. It was later bundled with the 15th volume of the manga.</i>", "startDate": {"year": 2014, "month": 11}, "endDate": {"year": 2014, "month": 11}, "season": "FALL", "seasonYear": 2014, "episodes": 1, "duration": 25, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": "#hq_anime", "genres": ["Comedy", "Drama", "Sports"], "tags": [{"name": "Volleyball", "rank": 88, "isAdult": false}, {"name": "Male Protagonist", "rank": 80, "isAdult": false}, {"name": "Shounen", "rank": 79, "isAdult": false}, {"