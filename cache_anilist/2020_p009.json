{"data": {"Page": {"pageInfo": {"currentPage": 9, "hasNextPage": true}, "media": [{"id": 119929, "title": {"romaji": "Yi Shijie Zhongyao Pu", "english": null}, "format": "ONA", "description": "After graduating from the University of Traditional Chinese Medicine, Sun Jiayou returned home to inherit a traditional Chinese medicine shop. He found that although the people here would not use medicine as a treatment, they had own spiritual system. To realize his grandfather’s dream, he plans to promote Chinese medicine in a different world. However, the spirit messenger considers it a big threat. In some confrontations with the spirit messenger, he discovers a greater mystery.", "startDate": {"year": 2020, "month": 5}, "endDate": {"year": 2020, "month": 9}, "season": null, "seasonYear": null, "episodes": 40, "duration": 10, "countryOfOrigin": "CN", "source": "MANGA", "hashtag": null, "genres": ["Drama", "Fantasy"], "tags": [{"name": "Medicine", "rank": 79, "isAdult": false}, {"name": "Tragedy", "rank": 79, "isAdult": false}, {"name": "Isekai", "rank": 79, "isAdult": false}, {"name": "Historical", "rank": 60, "isAdult": false}, {"name": "Full CGI", "rank": 20, "isAdult": false}]}, {"id": 119938, "title": {"romaji": "Xingchen Bian: Yuli Canghai", "english": null}, "format": "ONA", "description": "The second season of <i>Xingchen Bian</i>.", "startDate": {"year": 2020, "month": 5}, "endDate": {"year": 2020, "month": 5}, "season": null, "seasonYear": null, "episodes": 12, "duration": 25, "countryOfOrigin": "CN", "source": "WEB_NOVEL", "hashtag": null, "genres": ["Action", "Adventure", "Fantasy", "Romance"], "tags": [{"name": "Cultivation", "rank": 60, "isAdult": false}, {"name": "Male Protagonist", "rank": 60, "isAdult": false}, {"name": "Full CGI", "rank": 50, "isAdult": false}, {"name": "Martial Arts", "rank": 20, "isAdult": false}, {"name": "Swordplay", "rank": 20, "isAdult": false}]}, {"id": 119960, "title": {"romaji": "Katarina to Manabou", "english": null}, "format": "ONA", "description": "A new Hamefura mini anime posted on the official twitter.", "startDate": {"year": 2020, "month": 5}, "endDate": {"year": 2020, "month": 7}, "season": "SPRING", "seasonYear": 2020, "episodes": 9, "duration": 1, "countryOfOrigin": "JP", "source": "LIGHT_NOVEL", "hashtag": "#カタリナと学ぼう #はめふら", "genres": ["Comedy"], "tags": [{"name": "Flash", "rank": 79, "isAdult": false}, {"name": "Medieval", "rank": 79, "isAdult": false}, {"name": "Chibi", "rank": 73, "isAdult": false}, {"name": "Female Protagonist", "rank": 60, "isAdult": false}, {"name": "Isekai", "rank": 60, "isAdult": false}]}, {"id": 119978, "title": {"romaji": "Gigigoegoe: Sunghyungsoo", "english": "Beauty Water"}, "format": "MOVIE", "description": "Beauty Water looks like a common skin cosmetic. But unlike other cosmetics, people can sculpt their skin with it like molding clay and change their appearance. An ordinary girl, Yaeji, comes across the 'Beauty Water' by chance, and her endless desire to be the most beautiful woman brings her unimaginable disaster.", "startDate": {"year": 2020, "month": 9}, "endDate": {"year": 2020, "month": 9}, "season": null, "seasonYear": null, "episodes": 1, "duration": 85, "countryOfOrigin": "KR", "source": "MANGA", "hashtag": null, "genres": ["Horror", "Thriller"], "tags": [{"name": "Tragedy", "rank": 96, "isAdult": false}, {"name": "Body Horror", "rank": 96, "isAdult": false}, {"name": "Nudity", "rank": 79, "isAdult": false}, {"name": "CGI", "rank": 79, "isAdult": false}, {"name": "Makeup", "rank": 79, "isAdult": false}, {"name": "Body Image", "rank": 79, "isAdult": false}, {"name": "Bullying", "rank": 76, "isAdult": false}, {"name": "Full CGI", "rank": 75, "isAdult": false}, {"name": "Revenge", "rank": 70, "isAdult": false}, {"name": "Female Protagonist", "rank": 68, "isAdult": false}, {"name": "Monster Girl", "rank": 66, "isAdult": false}, {"name": "Gore", "rank": 64, "isAdult": false}, {"name": "Gender Bending", "rank": 46, "isAdult": false}]}, {"id": 120046, "title": {"romaji": "Ani ni Tsukeru Kusuri wa Nai! 4", "english": "Take My Brother Away! 4"}, "format": "ONA", "description": "Shi Miao has a lot of experience dealing with her older brother's peculiar habits. After all her scolding, it is natural to expect that Shi Fen's antics would come to an end. But having spent their whole life together, it is obvious to Miao that some things never change—and maybe that is for the best.\n<br><br>\nDespite his recklessness, Fen usually means well. As a result, a tight-knit friend group has formed around him and his sister. Joined by their classmates—Kai Xin, Wan Sui, and Miaomiao—the Shi siblings' tenure at high school continues to be an absolute spectacle.\n<br><br>\n(Source: MAL Rewrite)\n<br><br>\n<i>Note: Airing dates reflect the original airing and premiere dates in China, where it aired earlier than it did in Japan.</i>", "startDate": {"year": 2020, "month": 8}, "endDate": {"year": 2020, "month": 10}, "season": "SUMMER", "seasonYear": 2020, "episodes": 12, "duration": 4, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Comedy", "Slice of Life"], "tags": [{"name": "Primarily Teen Cast", "rank": 79, "isAdult": false}, {"name": "Primarily Male Cast", "rank": 79, "isAdult": false}, {"name": "School", "rank": 60, "isAdult": false}, {"name": "Episodic", "rank": 60, "isAdult": false}, {"name": "Slapstick", "rank": 60, "isAdult": false}, {"name": "Family Life", "rank": 46, "isAdult": false}, {"name": "Bisexual", "rank": 40, "isAdult": false}, {"name": "Foreign", "rank": 20, "isAdult": false}, {"name": "Female Protagonist", "rank": 20, "isAdult": false}, {"name": "Male Protagonist", "rank": 20, "isAdult": false}]}, {"id": 120055, "title": {"romaji": "Fei Ren Zai: Lichun Pian", "english": null}, "format": "ONA", "description": "The third part of <i>Fei Ren Zai</i>.", "startDate": {"year": 2020, "month": 6}, "endDate": {"year": 2020, "month": 8}, "season": null, "seasonYear": null, "episodes": 12, "duratio