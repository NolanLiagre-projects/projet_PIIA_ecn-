{"data": {"Page": {"pageInfo": {"currentPage": 3, "hasNextPage": false}, "media": [{"id": 103771, "title": {"romaji": "Ame no Ten Ten", "english": null}, "format": "MUSIC", "description": "A young lady listens to the music of falling rain.", "startDate": {"year": 1985, "month": 6}, "endDate": {"year": 1985, "month": 6}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 103775, "title": {"romaji": "Rainbow signal: Hi-Fi Set", "english": null}, "format": "MUSIC", "description": "These are six loosely-related anime/live-action music videos from the band Hi-Fi Set. For the most part, they form a story about the love life of two cute dragons who live in a high-tech future city. This disc was released in 1985, right in the middle of Hi-Fi Set's career (1974-1994), and features songs from that era (from their 1984 and 1985 albums Pasadena Park and Indigo).\n<br><br>\n(Source: Piyo-Piyo Productions)", "startDate": {"year": 1985, "month": null}, "endDate": {"year": 1985, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 29, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": ["Fantasy", "Romance"], "tags": [{"name": "Dinosaurs", "rank": 79, "isAdult": false}, {"name": "Animals", "rank": 79, "isAdult": false}, {"name": "Space", "rank": 60, "isAdult": false}, {"name": "Space Opera", "rank": 10, "isAdult": false}]}, {"id": 103986, "title": {"romaji": "Makkuramori no Uta", "english": null}, "format": "MUSIC", "description": "When the last ray of the sun disappears, the day ends. But in the forest, a world that is hidden during the day awakens with the darkness.\n<br><br>\n(Source: Anisearch)", "startDate": {"year": 1985, "month": null}, "endDate": {"year": 1985, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": [], "tags": [