l, "episodes": 1, "duration": 9, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Sci-Fi"], "tags": []}, {"id": 101524, "title": {"romaji": "Hoshi no Yuuenchi", "english": "Hoshi no Yuuenchi"}, "format": "OVA", "description": "A kindly teacher demonstrates origami to his elementary class, but when he gives a paper crane to a child, it is stolen from him by Takeshi, the class bully. Takeshi discovers that the crane is really a talking spaceship that takes him and his friends to visit a fairground in the stars.\n<br><br>\nA girl falls through a hole into Space Hell, and the children cooperate to rescue her. Takeshi wakes up, wondering if it was all a dream. The next day, he returns the magic crane to its rightful owner. This tale is from Rainbow Across the Pacific's Daisuke Ikeda, the leader of the buddhist Soka Gakkai organization which is commonly considered a cult as it is a part of the shinshuukyou religious movement.\n<br><br>\n(Source: Anime Encyclopedia)", "startDate": {"year": 1989, "month": 10}, "endDate": {"year": 1989, "month": 10}, "season": null, "seasonYear": null, "episodes": 1, "duration": 18, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Adventure", "Sci-Fi"], "tags": []}, {"id": 103336, "title": {"romaji": "Wonderful World: Ganmen Shintaisou", "english": null}, "format": "MUSIC", "description": "A whimsical calisthenics song about how wonderful the world is from grand things like romantic proposals to mundane things like good dental care.", "startDate": {"year": 1989, "month": 10}, "endDate": {"year": 1989, "month": 10}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 103415, "title": {"romaji": "Miira no Yume", "english": "The Mummy's Dream"}, "format": "MOVIE", "description": "The filmic version of a city in which all surface beauty has rotted away. In order to find images of death like landscapes of the city from which people have vanished, and buildings from which the decorations have been stripped away and the inner organs exposed, I walked all over Tokyo taking photographs, then animated them.\n<br><br>\n(Source: Takashi Ito)", "startDate": {"year": 1989, "month": 7}, "endDate": {"year": 1989, "month": 7}, "season": null, "seasonYear": null, "episodes": 1, "duration": 5, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 103542, "title": {"romaji": "Hikaru GENJI: Paradise Ginga", "english": null}, "format": "MUSIC", "description": "The official music video for Hikaru Genji's single \"Paradise Ginga.\"", "startDate": {"year": 1989, "month": 3}, "endDate": {"year": 1989, "month": 3}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": [], "tags": []}, {"id": 104350, "title": {"romaji": "Soratobu Penguin", "english": null}, "format": "MUSIC", "description": "Two penguins in love soar with emotions.\n", "startDate": {"year": 1989, "month": null}, "endDate": {"year": 1989, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Romance"], "tags": [{"name": "Animals", "rank": 20, "isAdult": false}]}, {"id": 110381, "title": {"romaji": "Mimizu Monogatari", "english": null}, "format": "MOVIE", "description": "Short film by Kurosaka Keita.", "startDate": {"year": 1989, "month": null}, "endDate": {"year": 1989, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 14, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Psychological"], "tags": []}, {"id": 113333, "title": {"romaji": "Meow no Hoshi", "english": null}, "format": "MOVIE", "description": "Story about a girl and her cat Meow.\n\nNote: Produced by Yoyogi Animation School and created entirely by its students fr