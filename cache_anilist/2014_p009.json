d": 102470, "title": {"romaji": "Daze", "english": "Daze"}, "format": "MUSIC", "description": "Daze is the opening theme of Mekakucity Actors performed by MARiA from GARNiDELiA. The song was composed by Shizen no Teki-P (a.k.a. Jin) and a PV for the anime was illustrated and directed by Shidu. The full song was released on May 29, 2014 by Jin.\n<br><br>\n(Source: Kagerou Project Wikia)", "startDate": {"year": 2014, "month": 5}, "endDate": {"year": 2014, "month": 5}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Ensemble Cast", "rank": 79, "isAdult": false}, {"name": "Primarily Teen Cast", "rank": 79, "isAdult": false}, {"name": "Advertisement", "rank": 20, "isAdult": false}]}, {"id": 102504, "title": {"romaji": "Mekakucity V's", "english": "Mekakucity V's"}, "format": "MUSIC", "description": "Mekakucity V's is a music video collection of the popular series multi editor creation \"Kagerou Project.\" It includes 13 recorded songs (10 of which were previously released on DVD), and in addition, a bonus MV of Shounen Brave that was made especially ​​for this work.\n<br><br>\nIncluded four videos are:<br>\n1. <b>Yuukei Yesterday</b> (夕景イエスタディ) original web release August 4, 2013.<br>\n2. <b>Outer Science</b> (アウターサイエンス) original web release August 31, 2013.<br>\n3. <b>Summer Time Record</b> (サマータイムレコード) original web release September 2, 2013.<br>\n4. <b>Shounen Brave</b> (少年ブレイヴ) this was a DVD-exclusive MV.\n<br><br>\n(Source: Kagerou Project Wikia)", "startDate": {"year": 2014, "month": 1}, "endDate": {"year": 2014, "month": 1}, "season": null, "seasonYear": null, "episodes": 4, "duration": 4, "countryOfOrigin": "JP", "source": "OTHER", "hashtag": null, "genres": ["Romance", "Supernatural"], "tags": [{"name": "Vocal Synth", "rank": 79, "isAdult": false}, {"name": "Time Manipulation", "rank": 79, "isAdult": false}, {"name": "Super Power", "rank": 79, "isAdult": false}, {"name": "Female Protagonist", "rank": 79, "isAdult": false}, {"name": "Male Protagonist", "rank": 79, "isAdult": false}, {"name": "Tragedy", "rank": 79, "isAdult": false}, {"name": "Primarily Teen Cast", "rank": 79, "isAdult": false}, {"name": "Idol", "rank": 60, "isAdult": false}, {"name": "Unrequited Love", "rank": 60, "isAdult": false}]}, {"id": 102554, "title": {"romaji": "Eine Kleine", "english": null}, "format": "MUSIC", "description": "The song Eine Kleine from the Album Yankee was written as a commercial for Tokyo Metro, and features lyrics about looking forward despite adversity.\n<br><br>\n(Source: Billboard Japan)", "startDate": {"year": 2014, "month": 4}, "endDate": {"year": 2014, "month": 4}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Drama", "Romance", "Slice of Life"], "tags": [{"name": "Advertisement", "rank": 20, "isAdult": false}]}, {"id": 102557, "title": {"romaji": "Ulibyeol Ilhowa Eollugso", "english": "The Satellite Girl and Milk Cow"}, "format": "MOVIE", "description": "An adventure by Il-ho the Satellite Girl and a shy cow to save the world from a black monster.\n<br><br>\n\"The Satellite Girl and Milk Cow\" is a debuting animation by Jang Hyeong-yoon who is also known as the 'genius director' for his achievements in the omnibus movie \"Indie Anibox: Selma's Protein Coffee\" and others.\n<br><br>\n(Source: HanCinema)", "startDate": {"year": 2014, "month": 2}, "endDate": {"year": 2014, "month": 2}, "season": null, "seasonYear": null, "episodes": 1, "duration": 81, "countryOfOrigin": "KR", "source": "ORIGINAL", "hashtag": null, "genres": ["Comedy", "Music", "Romance"], "tags": [{"name": "Animals", "rank": 79, "isAdult": false}, {"name": "Philosophy", "rank": 79, "isAdult": false}, {"name": "Henshin", "rank": 79, "isAdult": false}, {"name": "Heterosexual", "rank": 60, "isAdult": false}, {"name": "Shapeshifting", "rank": 60, "isAdult": false}, {"name": "Artificial Intelligence", "rank": 60, "isAdult": false}, {"name": "Real Robot", "rank": 60, "isAdult": false}, {"name": "Survival", "rank": 60, "isAdult": false}, {"name": "Rehabilitation", "rank": 60, "isAdult": false}, {"name": "Urban", "rank": 60, "isAdult": false}, {"name": "Coming of Age", "rank": 60, "isAdult": false}, {"name": "Space", "rank": 40, "isAdult": false}, {"name": "Kuudere", "rank": 40, "isAdult": false}, {"name": "Witch", "rank": 20, "isAdult": false}]}, {"id": 102563, "title": {"romaji": "Through the Windows", "english": null}, "format": "MOVIE", "description": "The gaze of a woman from a window to windows leads to a recollection of the various scenes. The metamorphosed windows transfer, expand, reflect, conserve, and sometimes shine like a lighthouse. \n<br><br>\n1st year work 2014, Tokyo University of the Arts, Graduate School of Film and New Media, Department of Animation\n<br><br>\n(Source: Geidai Animation)", "startDate": {"year": 2014, "month": null}, "endDate": {"year": 2014, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 3, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Psychological"], "tags": [{"name": "No Dialogue", "rank": 79, "isAdult": false}, {"name": "Female Protagonist", "rank": 20, "isAdult": false}]}, {"id": 102572, "title": {"romaji": "White Album 2 Picture Drama", "english": "White Album 2 Picture Drama"}, "format": "SPECIAL", "description": "Two picture drama episodes included in the last Blu-ray volume of the TV series.\n", "startDate": {"year": 2014, "month": 5}, "endDate": {"year": 2014, "month": 5}, "season": "SPRING", "seasonYear": 2014, "episodes": 2, "duration": 6, "countryOfOrigin": "JP", "source": "VISUAL_NOVEL", "hashtag": null, "genres": ["Drama", "Ecchi"], "tags": [{"name": "Kuudere", "rank": 20, "isAdult": false}]}, {"id": 102579, "title": {"romaji": "Toyoichi", "english": null}, "format": "MUSIC", "description": "Official music video for Lai Lai Lai Team's song Toyoichi which was included on the album of the same name", "startDate": {"year": 2014, "month": 8}, "endDate": {"year": 2014, "month": 8}, "season": null, "seasonYear": null, "episodes": 1, "duration": 3, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 102582, "title": {"romaji": "Puchimas!! Petit Petit iDOLM@STER: Fuyu-->Kotatsu<--Haru", "english": null}, "format": "OVA", "description": "Based on the 4-koma spin-off manga by Akane, serialised in Dengeki Maou since 2011.\n<br><br>\nTakane does not want to put the kotatsu away, even though it's spring. This leads to a huge court battle lead by the Producer and Takanya, on whether the kotatsu should be taken away or not.\n<br><br>\nNote: Bundled with the limited edition of the Puchimas! manga, volume 6.\n<br><br>\n(Source: EN Wikipedia)", "startDate": {"year": 2014, "month": 3}, "endDate": {"year": 2014, "month": 3}, "season": "WINTER", "seasonYear": 2014, "episodes": 1, "duration": 15, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Comedy", "Slice of Life"], "tags": []}, {"id": 102605, "title": {"romaji": "true tears × Hanasaku Iroha × TARITARI: Utopia", "english": null}, "format": "MUSIC", "description": "Utopia is a song that was specially created for the True Tears x Hanasaku Iroha x Tari Tari Joint Festival Live featuring the seiyuu (voice actors) from the three series. P.A. Works produced a video of this song which is included in the the Blu-ray release of this event.", "startDate": {"year": 2014, "month": 2}, "endDate": {"year": 2014, "month": 2}, "season": null, "seasonYear": null, "episodes": 1, "duration": 1, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Primarily Female Cast", "rank": 20, "isAdult": false}]}, {"id": 102611, "title": {"romaji": "HIMITSU Spark", "english": "Himitsu Spark"}, "format": "MUSIC", "description": "Music video for the song \"H