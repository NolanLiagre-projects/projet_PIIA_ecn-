th": 8}, "endDate": {"year": 2021, "month": 8}, "season": "SUMMER", "seasonYear": 2021, "episodes": 1, "duration": 38, "countryOfOrigin": "JP", "source": "OTHER", "hashtag": null, "genres": ["Comedy", "Fantasy", "Mystery"], "tags": [{"name": "Detective", "rank": 20, "isAdult": false}]}, {"id": 132806, "title": {"romaji": "Isekai Shokudou 2", "english": "Restaurant to Another World 2"}, "format": "TV", "description": "The restaurant is opening up again with new characters and new dishes.<br>\n<br>\nThere is a certain restaurant in the first basement level of a multi-tenant building in one corner of a shopping street near the office district. The historical restaurant, marked by a sign with a picture of a cat, is called \"Western Cuisine Nekoya.\" This restaurant looks completely normal through the week, but on Saturdays, it opens in secret exclusively to some very unique guests. During these hours, doors in various areas of a parallel world open to allow customers of many different races and cultures into the restaurant.<br>\n<br>\n(Source: Crunchyroll)", "startDate": {"year": 2021, "month": 10}, "endDate": {"year": 2021, "month": 12}, "season": "FALL", "seasonYear": 2021, "episodes": 12, "duration": 24, "countryOfOrigin": "JP", "source": "LIGHT_NOVEL", "hashtag": "#異世界食堂", "genres": ["Fantasy", "Slice of Life"], "tags": [{"name": "Restaurant", "rank": 100, "isAdult": false}, {"name": "Food", "rank": 95, "isAdult": false}, {"name": "Isekai", "rank": 90, "isAdult": false}, {"name": "Episodic", "rank": 89, "isAdult": false}, {"name": "Monster Girl", "rank": 86, "isAdult": false}, {"name": "Work", "rank": 85, "isAdult": false}, {"name": "Elf", "rank": 73, "isAdult": false}, {"name": "Fairy", "rank": 70, "isAdult": false}, {"name": "Dragons", "rank": 60, "isAdult": false}, {"name": "Urban Fantasy", "rank": 60, "isAdult": false}, {"name": "Anthropomorphism", "rank": 60, "isAdult": false}, {"name": "Mermaid", "rank": 60, "isAdult": false}, {"name": "Monster Boy", "rank": 6