{"data": {"Page": {"pageInfo": {"currentPage": 14, "hasNextPage": true}, "media": [{"id": 139736, "title": {"romaji": "HOWL", "english": null}, "format": "MUSIC", "description": "Music video directed by akka for the song <I>HOWL</I> by Ayaka Ohashi.", "startDate": {"year": 2020, "month": 12}, "endDate": {"year": 2020, "month": 12}, "season": null, "seasonYear": null, "episodes": 1, "duration": 3, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": "#大橋彩香", "genres": ["Action"], "tags": []}, {"id": 139771, "title": {"romaji": "Penguin Minna Kyou Dai 2020", "english": null}, "format": "MUSIC", "description": "Music video directed by Yoshiki Imazu for the short version of Masashi Sada's song Penguin Minna Kyou Dai 2020 that was included on his album \"Raison d'être\". The song is a remake of his 1997 single about stopping CO2 emissions. The 2020 song expands on this message to include the broader Sustainable Development Goals proposed by the United Nations.", "startDate": {"year": 2020, "month": 4}, "endDate": {"year": 2020, "month": 4}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "OTHER", "hashtag": null, "genres": [], "tags": []}, {"id": 139809, "title": {"romaji": "Lagtrain", "english": "Lagtrain"}, "format": "MUSIC", "description": "A music video for the song <i>Lagtrain</i> by inabakumori.", "startDate": {"year": 2020, "month": 7}, "endDate": {"year": 2020, "month": 7}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Trains", "rank": 100, "isAdult": false}, {"name": "Achromatic", "rank": 72, "isAdult": false}, {"name": "Vocal Synth", "rank": 70, "isAdult": false}, {"name": "Urban", "rank": 60, "isAdult": false}, {"name": "Female Protagonist", "rank": 60, "isAdult": false}, {"name": "Denpa", "rank": 40, "isAdult": false}]}, {"id": 139843, "title": {"romaji": "Himitsu", "english": "Secret"}, "format": "MUSIC", "description": "Music video for the song <i>Himitsu</i>, directed, animated, and musically written by Harumaki Gohan.<br>\n<br>\n<i>Note: This entry contains two music videos, each featuring a different lead character and singer; one is a self-cover by the artist on Harumaki Gohan's YouTube channel, and the other a Hatsune Miku version uploaded to Harumaki Gohan's Niconico account, which was released on the same day.</i>", "startDate": {"year": 2020, "month": 4}, "endDate": {"year": 2020, "month": 4}, "season": null, "seasonYear": null, "episodes": 2, "duration": 5, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Robots", "rank": 60, "isAdult": false}, {"name": "Female Protagonist", "rank": 20, "isAdult": false}]}, {"id": 140029, "title": {"romaji": "Kata no Ato", "english": "The mark of Emi"}, "format": "MOVIE", "description": "My friend Emi appeared in my dream. I was so surprised by this, I couldn't face her at school that day. But I forgot that we had to go to the swimming pool for PE class that afternoon, so I ended up having to borrow Emi's swimsuit.\n<br><br>\nFurukawahara Momoka's graduation work from 2019 at Tokyo Zokei University.", "startDate": {"year": 2020, "month": 8}, "endDate": {"year": 2020, "month": 8}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Romance"], "tags": [{"name": "LGBTQ+ Themes", "rank": 86, "isAdult": false}, {"name": "Yuri", "rank": 72, "isAdult": false}, {"name": "School", "rank": 72, "isAdult": false}, {"name": "Primarily Female Cast", "rank": 60, "isAdult": false}, {"name": "Nudity", "rank": 56, "isAdult": false}, {"name": "Graduation Project", "rank": 20, "isAdult": false}, {"name": "Primarily Child Cast", "rank": 10, "isAdult": false}]}, {"id": 140160, "title": {"romaji": "Suisei ni Nareta Nara", "english": "If I Could Become a Comet"}, "format": "MUSIC", "description": "Music video directed and animated by Harumaki Gohan for the song <i>If I Could Become a Comet</i> by Harumaki Gohan.\n<br><br>\n<i>Note: There exists two versions of this song; the first being a self-cover version by Harumaki Gohan on YouTube, and a vocaloid version featuring Hatsune Miku on NicoNico.</i>", "startDate": {"year": 2020, "month": 6}, "endDate": {"year": 2020, "month": 6}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Coastal", "rank": 79, "isAdult": false}, {"name": "Trains", "rank": 79, "isAdult": false}, {"name": "Robots", "rank": 79, "isAdult": false}, {"name": "Astronomy", "rank": 79, "isAdult": false}]}, {"id": 140362, "title": {"romaji": "Mister Jewel Box", "english": "Mister Jewel Box"}, "format": "MUSIC", "description": "Music video for the song <i>Mister Jewel Box</i> by TOPHAMHAT-KYO.<br>\n<br>\nThe story is taking TOPHAMHAT-KYO’s real experiences and exaggerating them.\nAn ordinary man, who got a character to represent him, and becomes famous because of it.\nBut, as time goes on, he realizes that the character is more popular than him. It’s a story about him facing that reality which makes him jealous, suffer, and distressed, leading to the end where the tables have turned completely.", "startDate": {"year": 2020, "month": 8}, "endDate": {"year": 2020, "month": 8}, "season": null, "seasonYear": null, "episodes": 1, "duration": 3, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Drama"], "tags": []}, {"id": 140370, "title": {"romaji": "Doggie Corgi 2", "english": "Doggie Corgi 2"}, "format": "ONA", "description": "Each 1-minute looping episode was uploaded simultaneously on the Doggie Corgi Instagram and YouTube channels.\n<br><br>\n<i>Notes:<br>\n• The episodes exist in 2 versions on YouTube, a \"Loop Ani\" version which includes music, and an \"ASMR Ani\" version which only contains ambient noise.<br>\n• Contains special episode \"Bomeun Eonjena Yeogie&#127800;\"<i>", "startDate": {"year": 2019, "month": 12}, "endDate": {"year": 2020, "month": 7}, "season": null, "seasonYear": null, "episodes": 16, "duration": 1, "countryOfOrigin": "KR", "source": "ORIGINAL", "hashtag": null, "genres": ["Slice of Life"], "tags": [{"name": "Iyashikei", "rank": 20, "isAdult": false}]}, {"id": 140378, "title": {"romaji": "POP UP TO YOU", "english": "POP UP TO YOU"}, "format": "MOVIE", "description": "Yamakita Higashi's 2020 Tama Art University graduation project.", "startDate": {"year": 2020, "month": null}, "endDate": {"year": 2020, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Music"], "tags": [{"name": "Graduation Project", "rank": 79, "isAdult": false}]}, {"id": 140382, "title": {"romaji": "Yonde Yobarete", "english": "call me, call you"}, "format": "MOVIE", "description": "Graduation work of Miho Takahashi at Tama Art University.", "startDate": {"year": 2020, "month": null}, "endDate": {"year": 2020, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "No Dialogue", "rank": 20, "isAdult": false}]}, {"id": 140384, "title": {"romaji": "Mubi", "english": "mubi"}, "format": "MOVIE", "description": "Graduation work of Tomoe Obayashi at Tama Art University.", "startDate": {"year": 2020, "month": null}, "endDate": {"year": 2020, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 6, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Psychological"], "tags": []}, {"id": 140599, "title": {"romaji": "Follow", "english": "Follow"}, "format": "MOVIE", "description": "Graduation work of Zhang Lihong at Tama Art University.", "startDate": {"year": 2020, "month": null}, "endDate": {"year": 2020, "mo