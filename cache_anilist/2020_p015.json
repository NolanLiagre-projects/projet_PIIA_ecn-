{"data": {"Page": {"pageInfo": {"currentPage": 15, "hasNextPage": true}, "media": [{"id": 154040, "title": {"romaji": "Ikiru Kabe", "english": null}, "format": "MOVIE", "description": "A visual poem that embodies the spirit of a 'wall' that cannot move even a little, is left in the same place and sees off those who are passing by, rotting away in solitude, and yet continues to live on.", "startDate": {"year": 2020, "month": null}, "endDate": {"year": 2020, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 6, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 154118, "title": {"romaji": "DINO!", "english": null}, "format": "MOVIE", "description": "The boy and his friend Dino the crocodile continued their journey to find the lost crown. A tapir is chasing them.", "startDate": {"year": 2020, "month": null}, "endDate": {"year": 2020, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 25, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Stop Motion", "rank": 60, "isAdult": false}, {"name": "Dinosaurs", "rank": 60, "isAdult": false}, {"name": "CGI", "rank": 20, "isAdult": false}]}, {"id": 154119, "title": {"romaji": "Marco to Ginga Ryuu", "english": null}, "format": "OVA", "description": "Marco, an orphan with missing memories, and Arco, a dragon who rules the galaxy, were hunting for treasure in space! On one of their adventures, Marco was given a clue to the whereabouts of her mother. Their next stop, her birthplace - Earth!\n<br><br>\n(Source: Steam)\n<br><br>\n<i>Note: (OVA bundled as a bonus Blu-Ray disc with the physical release of the game)</i>", "startDate": {"year": 2020, "month": 2}, "endDate": {"year": 2020, "month": 2}, "season": "WINTER", "seasonYear": 2020, "episodes": 1, "duration": 24, "countryOfOrigin": "JP", "source": "MULTIMEDIA_PROJECT", "hashtag": null, "genres": ["Adventure", "Comedy"], "tags": []}, {