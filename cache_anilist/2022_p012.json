ate": {"year": 2022, "month": 2}, "season": null, "seasonYear": null, "episodes": 1, "duration": 3, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Werewolf", "rank": 79, "isAdult": false}, {"name": "Vocal Synth", "rank": 20, "isAdult": false}]}, {"id": 150973, "title": {"romaji": "Itsuwari", "english": null}, "format": "MUSIC", "description": "Music video for the song <i>Itsuwari</i> by Miu.<br><br>\n\nIn winter of 1962, for the first time ever in Japan, an exquisite counterfeit bill was discovered. The 1.000 Yen counterfeit bill was used in a skillful manner, so that in the end no culprit was ever found and arrested. One of the counterfeit-bills was placed in a time capsule together with a real bill at the Osaka-Kansai Expo. The theme of the MV is inspired by the story of the counterfeit 1.000 Yen bill. The counterfeit bill was deceiving everyone just like the person in the song. If I believe my own lies, will the lie become the truth? <br><br>\n\n(Source: YouTube description)", "startDate": {"year": 2022, "month": 4}, "endDate": {"year": 2022, "month": 4}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 151008, "title": {"romaji": "Serenade", "english": "Serenade"}, "format": "MUSIC", "description": "Music video animated by Gaako for the song <i>Serenade</i> by Uru.", "startDate": {"year": 2022, "month": 6}, "endDate": {"year": 2022, "month": 6}, "season": null, "seasonYear": null, "episodes": 1, "duration": 5, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": "#セレナーデ", "genres": [], "tags": [{"name": "Musical Theater", "rank": 79, "isAdult": false}]}, {"id": 151063, "title": {"romaji": "Menghuan Shuyuan 7", "english": null}, "format": "ONA", "description": "The seventh season of <i>Menghuan Shuyuan</i>.", "startDate": {"year": 2022, "month": 6}, "endDate": {"year": 2022, "month": 8}, "season"