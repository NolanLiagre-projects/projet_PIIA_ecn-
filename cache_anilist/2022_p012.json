tag": null, "genres": ["Adventure"], "tags": [{"name": "Advertisement", "rank": 60, "isAdult": false}]}, {"id": 150848, "title": {"romaji": "HELLO CALLiNG", "english": null}, "format": "MUSIC", "description": "Music video for the song HELLO CALLiNG by IDOLISH7. The second in a series of lyric videos released during each group anniversary, celebrating the franchise's 7th anniversary.", "startDate": {"year": 2022, "month": 6}, "endDate": {"year": 2022, "month": 6}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "VIDEO_GAME", "hashtag": "#IDOLiSH7記念日2022", "genres": [], "tags": [{"name": "Idol", "rank": 60, "isAdult": false}, {"name": "Primarily Male Cast", "rank": 60, "isAdult": false}]}, {"id": 150909, "title": {"romaji": "5-Oku-nen Button", "english": "500000000 years button"}, "format": "TV", "description": "The 500 million year button. Press that button and a million yen will come out. In exchange, you have to spend 500 million years in a completely empty space. However, the moment 500 million years have passed, your memory will be erased and you'll be right back where you started. For the person who pressed the button, it would be like a million yen in an instant.\n<br></br>\n5-year-old Tonio, 14-year-old Jaibi, and 17-year-old Suneko, were at a loss for money to pay for their father's treatment in the hospital. But then, in front of the three siblings, a person with the \"500 million year\" button appears...\n<br></br>\nA brand new animation based on the cult classic \"500 Million Year Button\" story from the <i>Minna no Tonio-chan</i> series!\n<br></br>\n(Source: 500,000,000-nen Button Official Home Page)", "startDate": {"year": 2022, "month": 7}, "endDate": {"year": 2022, "month": 9}, "season": "SUMMER", "seasonYear": 2022, "episodes": 12, "duration": 21, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": "#アニメ5億年ボタン", "genres": ["Psychological"], "tags": [{"name": "Philosophy", "rank": 98, "isAdult": f