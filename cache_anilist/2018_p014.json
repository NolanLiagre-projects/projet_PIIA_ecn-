episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Denpa", "rank": 79, "isAdult": false}, {"name": "Orphan", "rank": 79, "isAdult": false}, {"name": "Suicide", "rank": 79, "isAdult": false}, {"name": "Cyberpunk", "rank": 79, "isAdult": false}, {"name": "Vocal Synth", "rank": 79, "isAdult": false}, {"name": "Estranged Family", "rank": 79, "isAdult": false}]}, {"id": 140223, "title": {"romaji": "Ten made Tobaso", "english": null}, "format": "MUSIC", "description": "A little girl astronaut crashes her small ship out in space. There is a scientist there with his own much larger crashed ship. They spent time together as he repairs her ship and have a tearful departure.", "startDate": {"year": 2018, "month": 2}, "endDate": {"year": 2018, "month": 2}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 140237, "title": {"romaji": "Cairn no Kubi-tachi", "english": null}, "format": "MOVIE", "description": "<i>The Spirits of Cairn</i> imagines a state of limbo which is the destination of those who die in childhood. The protagonist feels remorse about having died too young, but the emotion is just an echo and he has no idea how long he’s been there, why he is there, or the source of his regret. His work of interring the many necks buried below the surface continues without end.<br>\n<br>\n(Source: Official Website)<br>\n<br>\nUndergraduate Work 2018, Tokyo University of the Arts, Faculty of Fine Arts, Department of Inter-Media Art.", "startDate": {"year": 2018, "month": null}, "endDate": {"year": 2018, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 7, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Puppetry", "rank": 20, "isAdult": false}]}, {"id": 140348, "title": {"romaji": "Shoujo Ikon", "english": "an iconic g