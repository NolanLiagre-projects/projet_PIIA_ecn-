glish": "Taro's Train"}, "format": "MOVIE", "description": "A combination of live action, traditional animation, and stop motion animation. A father buys his son a toy train, which he loves. When the boy goes to sleep, the train comes to life and crawls into the bed with the boy, giving him a dream about proper train etiquette.\n", "startDate": {"year": 1929, "month": 6}, "endDate": {"year": 1929, "month": 6}, "season": null, "seasonYear": null, "episodes": 1, "duration": 15, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Action"], "tags": [{"name": "Educational", "rank": 79, "isAdult": false}, {"name": "Trains", "rank": 73, "isAdult": false}, {"name": "Animals", "rank": 60, "isAdult": false}, {"name": "Achromatic", "rank": 60, "isAdult": false}, {"name": "Historical", "rank": 50, "isAdult": false}, {"name": "Primarily Child Cast", "rank": 40, "isAdult": false}, {"name": "Stop Motion", "rank": 40, "isAdult": false}, {"name": "Family Life", "rank": 30, "isAdult": false}, {"name": "Mixed Media", "rank": 20, "isAdult": false}]}, {"id": 5874, "title": {"romaji": "Sankou to Tako: Hyakumanryou Chinsoudou", "english": null}, "format": "MOVIE", "description": "Short movie from 1933.", "startDate": {"year": 1933, "month": null}, "endDate": {"year": 1933, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 15, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Action"], "tags": []}, {"id": 5875, "title": {"romaji": "Kobu-tori", "english": null}, "format": "MOVIE", "description": "Short movie from 1929.", "startDate": {"year": 1929, "month": 10}, "endDate": {"year": 1929, "month": 10}, "season": null, "seasonYear": null, "episodes": 1, "duration": 14, "countryOfOrigin": "JP", "source": "OTHER", "hashtag": null, "genres": ["Action", "Supernatural"], "tags": [{"name": "Achromatic", "rank": 79, "isAdult": false}, {"name": "Youkai", "rank": 79, "isAdult": false}, {"name": "Historical", "rank": 60, "is