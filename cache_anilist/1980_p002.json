}, {"id": 116033, "title": {"romaji": "Ganbare!! Tabuchi-kun!! Aa Tsuppari Jinsei", "english": null}, "format": "MOVIE", "description": null, "startDate": {"year": 1980, "month": 12}, "endDate": {"year": 1980, "month": 12}, "season": "FALL", "seasonYear": 1980, "episodes": 1, "duration": 96, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Comedy", "Sports"], "tags": [{"name": "Baseball", "rank": 20, "isAdult": false}]}, {"id": 117246, "title": {"romaji": "Ikkyuu-san: Ooabare Yancha-hime", "english": null}, "format": "SPECIAL", "description": "The rampant adventures of the mischievous Tsuyu take the lead here: \"Ikkyuu-dono! Let's Play!!\"\n<br><br>\n(Source: AniDB)", "startDate": {"year": 1980, "month": 8}, "endDate": {"year": 1980, "month": 8}, "season": null, "seasonYear": null, "episodes": 1, "duration": 50, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Comedy"], "tags": [{"name": "Historical", "rank": 79, "isAdult": false}, {"name": "Kids", "rank": 60, "isAdult": false}]}, {"id": 118078, "title": {"romaji": "Dekkai Totto March", "english": null}, "format": "MUSIC", "description": "A music video for the song Dekkai Totto March by Duke Aces that was featured on NHK's Minna no Uta program.", "startDate": {"year": 1980, "month": 8}, "endDate": {"year": 1980, "month": 8}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Kids", "rank": 79, "isAdult": false}]}, {"id": 120981, "title": {"romaji": "Suirin: Karma 2", "english": null}, "format": "MOVIE", "description": "A serene, abstract hand drawn animation by Nobuhiro Aihara, featuring Kitarou's song \"Asa no Inori\" from his album \"Oasis.\"", "startDate": {"year": 1980, "month": null}, "endDate": {"year": 1980, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Music"], "tags": []}, {"id": 123447, "title": {"romaji": "Xue Haizi", "english": null}, "format": "MOVIE", "description": "During the Winter season, mother rabbit has to go out, but she is afraid of leaving her son home alone. Her rabbit son decides to make a friend out of the snow to keep him company.\n", "startDate": {"year": 1980, "month": null}, "endDate": {"year": 1980, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 20, "countryOfOrigin": "CN", "source": "ORIGINAL", "hashtag": null, "genres": ["Fantasy"], "tags": [{"name": "Snowscape", "rank": 79, "isAdult": false}, {"name": "Kids", "rank": 60, "isAdult": false}]}, {"id": 130053, "title": {"romaji": "Little Nemo Pilot", "english": null}, "format": "SPECIAL", "description": "<i>Note: Included in the 31/07/2019 Japanese BluRay release</i>", "startDate": {"year": 1980, "month": null}, "endDate": {"year": 1980, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 8, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": ["Adventure", "Fantasy"], "tags": []}, {"id": 138780, "title": {"romaji": "San Zhi Lang", "english": null}, "format": "MOVIE", "description": "An old man goes to the market to sell some pork. However, on the way there, he is attacked by wolves on the mountain.\n<br><br>\nBased on the story of the same title from the collection of classical Chinese stories, <i>Strange Stories from a Chinese Studio (聊斋志异 - Laozhai Zhiyi)</i>. It features stop motion animation using origami.", "startDate": {"year": 1980, "month": null}, "endDate": {"year": 1980, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 9, "countryOfOrigin": "CN", "source": "OTHER", "hashtag": null, "genres": [], "tags": [{"name": "Stop Motion", "rank": 20, "isAdult": false}]}, {"id": 138922, "title": {"romaji": "Lao Lang Qingke", "english": null}, "format": "MOVIE", "description": "One day, the old wolf boiled a pot of chicken and was about to invite the old bear to taste it. Just after leaving the house, a fox sneaked in and ate the chicken. The fox who stole the chicken then fooled the two friends into arguing with each other.", "startDate": {"year": 1980, "month": null}, "endDate": {"year": 1980, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 10, "countryOfOrigin": "CN", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Animals", "rank": 20, "isAdult": false}]}, {"id": 140352, "title": {"romaji": "Hiromi", "english": null}, "format": "MUSIC", "description": "A song about a little girl named Hiromi who is the object of affection of a little boy.", "startDate": {"year": 1980, "month": 4}, "endDate": {"year": 1980, "month": 4}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 143711, "title": {"romaji": "Xiao Ya Gaga", "english": null}, "format": "MOVIE", "description": null, "startDate": {"year": 1980, "month": null}, "endDate": {"year": 1980, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 10, "countryOfOrigin": "CN", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Animals", "rank": 79, "isAdult": false}, {"name": "Stop Motion", "rank": 60, "isAdult": false}]}, {"id": 148068, "title": {"romaji": "Mr. Synthesizer", "english": null}, "format": "MUSIC", "description": "Music video for the song <i>Mr. Synthesizer</i> by the japanese comedian Tamori. It was featured on NHK's Minna no Uta program.", "startDate": {"year": 1980, "month": 10}, "endDate": {"year": 1980, "month": 10}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 148076, "title": {"romaji": "SHELTER", "english": null}, "format": "MOVIE", "description": "Set in a cave imagined as an air-raid shelter, images of the surrounding trees are painted over directly on the film. Vivid colors intermixed with the sound of wartime radio communications and bombing create a harmonious composition of documentary and animation. <br><br> (Source: Collaborative Cataloging Japan)", "startDate": {"year": 1980, "month": null}, "endDate": {"year": 1980, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 7, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Psychological"], "tags": []}, {"id": 168557, "title": {"romaji": "Versailles no Bara: Moetsukita Bara no Shouzou", "english": null}, "format": "SPECIAL", "description": "Due to a conflict in scheduling, the broadcast of <i>Versailles no Bara</i> was cancelled in several regions after episode 23. In order to conclude the story, an original episode titled <i>Moetsukita Bara no Shouzou</i> was created. While it features some similar story beats to the actual story, it differs greatly. This episode was never aired again or released on home video.", "startDate": {"year": 1980, "month": 3}, "endDate": {"year": 1980, "month": 3}, "season": "WINTER", "seasonYear": 1980, "episodes": 1, "duration": 24, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Drama", "Romance"], "tags": [{"name": "Shoujo", "rank": 20, "isAdult": false}]}, {"id": 169049, "title": {"romaji": "Shakkishaki no Tenkousei", "english": null}, "format": "MUSIC", "description": "Music video for the song <i>Shakkishaki no Tenkousei</i> by Kawasaki Boys & Girls Choir that was featured on NHK's Minna no Uta program.", "startDate": {"year": 1980, "month": 12}, "endDate": {"year": 1980, "month": 12}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 169326, "title": {"romaji": "Ofuro no Kazoe Uta", "english": null}, "format": "MUSIC", "description": "Music video for the song <i>Ofuro no Kazoe Uta</i> by Bikkuri Electric Company (Juuichi Sase) that was featured on Fuji TV's Hirake! Ponkikki program.", "startDate": {"year": 1980, "month": null}, "endDate": {"year": 1980, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 3, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 175753, "title": {"romaji": "Bus Tei Nite...", "english": null}, "format": "SPECIAL", "description": "Paper animation, directed and animated by Hideaki Anno while he was at university to show at a college screening \"First Pictures Show\".\n<br><br>\n(Source: Tokyo International Film Festival)", "startDate": {"year": 1980, "month": null}, "endDate": {"year": 1980, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 1, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Comedy"], "tags": [{"name": "Tragedy", "rank": 60, "isAdult": false}, {"name": "No Dialogue", "rank": 20, "isAdult": false}]}, {"id": 178454, "title": {"romaji": "Corazón de Date", "english": null}, "format": "MUSIC", "description": "Music video for the song <i>Corazón de Date</i> by OPA and Haruko Ishizaki, that was featured on NHK's Minna no Uta program.", "startDate": {"year": 1980, "month": 8}, "endDate": {"year": 1980, "month": 8}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 178455, "title": {"romaji": "Noraneko Sandogasa", "english": null}, "format": "MUSIC", "description": "Music video for the song <i>Noraneko Sandogasa</i> by Toshiyuki Nishida that was featured on NHK's Minna no Uta program.", "startDate": {"year": 1980, "month": 6}, "endDate": {"year": 1980, "month": 6}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 179841, "title": {"romaji": "Banana Split", "english": null}, "format": "MUSIC", "description": "Music video for the song <i>Banana Split</i> by Kyouzou Nishioka that was featured on NHK's Minna no Uta program.", "startDate": {"year": 1980, "month": 10}, "endDate": {"year": 1980, "month": 10}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 180866, "title": {"romaji": "Captain", "english": null}, "format": "SPECIAL", "description": "Before Captain became a TV series it was a one-shot TV special that garnered the highest ratings of any anime that month. For its re-run on August 20th, 30 minutes of new content was added in which brought in more ratings that trumped the previous statistic.", "startDate": {"year": 1980, "month": 4}, "endDate": {"year": 1980, "month": 4}, "season": "SPRING", "seasonYear": 1980, "episodes": 1, "duration": 114, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Sports"], "tags": [{"name": "Baseball", "rank": 20, "isAdult": false}]}, {"id": 182154, "title": {"romaji": "Hi no Kuni Monogatari", "english": null}, "format": "SPECIAL", "description": null, "startDate": {"year": 1980, "month": 5}, "endDate": {"year": 1980, "month": 5}, "season": null, "seasonYear": null, "episodes": 1, "duration": 90, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": [], "tags": []}, {"id": 182557, "title": {"romaji": "Yuan Yuan He Ji Qi Ren", "english": null}, "format": "MOVIE", "description": "The story takes place among a group of toys: the naughty Yuanyuan lost the shuttlecocks of two girls. In order to compensate for the shuttlecocks, he found chicken feathers. With the help of the robot, he caught a rooster, plucked the feathers and gave them to the little girls as compensation, but the two girls lost their shuttlecocks. The girl thought she shouldn't take the feathers, so she gave them back to the rooster.\n\n[Source: baike.baidu.com]", "sta