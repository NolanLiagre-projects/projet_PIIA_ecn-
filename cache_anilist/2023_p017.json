{"data": {"Page": {"pageInfo": {"currentPage": 17, "hasNextPage": false}, "media": [{"id": 185642, "title": {"romaji": "Nanashi Kaidan 2nd Season", "english": "Nanashi Kaidan 2nd Season"}, "format": "ONA", "description": "Second season of Nanashi Kaidan.\n<br><br>\nA mysterious man named Mukuroji tells a ghost story that no one knows and should not be known, that is Nanashi Kaidan. A girl named Bon and a boy named Koko join forces to seal away the supernatural.", "startDate": {"year": 2023, "month": 8}, "endDate": {"year": 2023, "month": 8}, "season": "SUMMER", "seasonYear": 2023, "episodes": 5, "duration": 6, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": "#ななし怪談 ", "genres": ["Horror", "Supernatural"], "tags": []}, {"id": 185747, "title": {"romaji": "Mugen ∞ 15-byou Animation", "english": null}, "format": "MOVIE", "description": "An anthology work produced by the Japan Animation Association for their Into Animation 8 festival held at The National Art Center, Tokyo.", "startDate": {"year": 2023, "month": null}, "endDate": {"year": 2023, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 15, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 186198, "title": {"romaji": "Oshiri Tantei: Cosmic Front", "english": null}, "format": "SPECIAL", "description": "Educational collaboration specials between Oshiri Tantei and the documentary show Cosmic Front.\n<br><br>\nMikku will help the Butt Detective solve a case, while also teaching the newest facts about dinosaur research and space rockets.\n<br><br>\n(Source: Anime News Network)", "startDate": {"year": 2023, "month": 3}, "endDate": {"year": 2023, "month": 3}, "season": "WINTER", "seasonYear": 2023, "episodes": 2, "duration": 25, "countryOfOrigin": "JP", "source": "PICTURE_BOOK", "hashtag": null, "genres": ["Comedy", "Fantasy", "Mystery"], "tags": []}, {"id": 186202, "title": {"romaji": "Secret Jouju: Byeolui Boseok", "english": "Secret Jouju - Bijou of Star"}, "format": "TV_SHORT", "description": "Jouju is tasked with finding the hidden Joubijou, balancing good and evil in the celestial world with her dear friends Cindy, Stellar, and the mysterious 'Rosa'. While getting back Joubijou from Lucy 'the treasure hunter', Jouju protects her family and friends from witches and navigates through a magical journey in order to become a true guardian of stars. <br> <br>\n\n(Source: Janson Media)", "startDate": {"year": 2023, "month": 11}, "endDate": {"year": 2023, "month": 12}, "season": null, "seasonYear": null, "episodes": 12, "duration": 14, "countryOfOrigin": "KR", "source": "ORIGINAL", "hashtag": null, "genres": ["Comedy", "Fantasy", "Mahou Shoujo"], "tags": []}, {"id": 186715, "title": {"romaji": "Shiori (2023)", "english": null}, "format": "MUSIC", "description": "Music video directed by Taku Kimura for the song <i>Shiori</i> by MyGO!!!!!", "startDate": {"year": 2023, "month": 6}, "endDate": {"year": 2023, "month": 6}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "MULTIMEDIA_PROJECT", "hashtag": "#MyGO", "genres": ["Psychological"], "tags": []}, {"id": 187051, "title": {"romaji": "Sylvanian Families: Freya kara no Okurimono", "english": "Sylvanian Families: The Movie - A Gift from Freya"}, "format": "MOVIE", "description": "The annual Star Festival arrives in Sylvanian Village again this year. While everyone is eagerly looking forward to it, Chocolate Rabbit girl Freya is worried. It's her mother's birthday on the day of the festival, and she can't think of a gift at all. Furthermore, Freya is appointed to the important role of preparing the festival's main event, the 'Tree of the Year.'\n<br><br>\nSo, what will Freya come up with to make her mother and her friends happy?\n<br><br>\n(Source: Apple TV)", "startDate": {"year": 2023, "month": 11}, "endDate": {"year": 2023, "month": 11}, "season": "FALL", "seasonYear": 2023, "episodes": 1, "duration"