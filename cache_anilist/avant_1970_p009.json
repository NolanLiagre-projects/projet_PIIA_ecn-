tion": "An old mouse gathers young mice and gives a speech about the dangers of cats, and then one young mouse plays a prank in a private house, falls into a water bowl and is rescued by his friends, but is attacked by a cat and escapes with a crawling body.\n<br><br>\n(Source: allcinema)", "startDate": {"year": 1917, "month": 7}, "endDate": {"year": 1917, "month": 7}, "season": null, "seasonYear": null, "episodes": 1, "duration": null, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 177127, "title": {"romaji": "Itazura Post", "english": null}, "format": "MOVIE", "description": "The events of a day in and around the main character, Post.\n<br><br>\n(Source: allcinema)", "startDate": {"year": 1917, "month": 7}, "endDate": {"year": 1917, "month": 7}, "season": null, "seasonYear": null, "episodes": 1, "duration": null, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 177180, "title": {"romaji": "Tarou no Banpei Senkoutei no Maki", "english": null}, "format": "MOVIE", "description": null, "startDate": {"year": 1918, "month": 8}, "endDate": {"year": 1918, "month": 8}, "season": null, "seasonYear": null, "episodes": 1, "duration": null, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 177216, "title": {"romaji": "Chamebou Kuukijuu no Maki", "english": null}, "format": "MOVIE", "description": null, "startDate": {"year": 1917, "month": 8}, "endDate": {"year": 1917, "month": 8}, "season": null, "seasonYear": null, "episodes": 1, "duration": null, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": [], "tags": []}, {"id": 177217, "title": {"romaji": "Yukidaruma", "english": null}, "format": "MOVIE", "description": "Follows a snowman who came to life in a fairytale-like setting.", "startDate": {"year": 1918, "month": 2}, "endDate": {"year": 1918, "month": 2}, "season": null, "seasonYear": null, "episodes": 1, "duration": null, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Fantasy"], "tags": []}, {"id": 177218, "title": {"romaji": "Kobutori", "english": null}, "format": "MOVIE", "description": "Based on the tale Kobutori-jiisan about an honest old man who encounters a band of tengu, mythical bird-like creatures making merry and joins their dancing. They liked his dancing so much that they removed an unsightly lump from the side of his face.", "startDate": {"year": 1918, "month": 3}, "endDate": {"year": 1918, "month": 3}, "season": null, "seasonYear": null, "episodes": 1, "duration": null, "countryOfOrigin": "JP", "source": "OTHER", "hashtag": null, "genres": [], "tags": []}, {"id": 177219, "title": {"romaji": "Kaeru no Yume", "english": null}, "format": "MOVIE", "description": null, "startDate": {"year": 1918, "month": 2}, "endDate": {"year": 1918, "month": 2}, "season": null, "seasonYear": null, "episodes": 1, "duration": null, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": [], "tags": []}, {"id": 177386, "title": {"romaji": "Anapoko", "english": null}, "format": "MOVIE", "description": "After graduating from Tama Art University, Nakajima made this work with the intention of submitting to the Sogetsu Animation Festival. Without much funding to work with, Nakajima devised the technique \"Kaki-mation,\" a method of drawing directly on 35mm film. At this time, he frequented Studio Zero—the formative mainstream animation production company of the period. \n<br><br>\n(Source: Collaborative Cataloging Japan)", "startDate": {"year": 1963, "month": null}, "endDate": {"year": 1963, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 7, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 177387, "title": {"romaji": "Seizoki", "english": null}, "format": "MOVIE", "description": "This is an animation using the \"Kaki-mation\" technique. This piece can be shown as a multiscreen piece with 3 screens. <br><br>(Source: Collaborative Cataloging Japan)", "startDate": {"year": 1964, "month": null}, "endDate": {"year": 1964, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 4, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 177503, "title": {"romaji": "Koukoueisei", "english": null}, "format": "MOVIE", "description": "The 8-and-half-minute long anime was made as an educational film to raise awareness for the prevention of cavities.<br>\nThe film is said to have been produced by a company that sold toothbrushes and other daily necessities.<br><br>\n(Source: NHK World)", "startDate": {"year": 1923, "month": null}, "endDate": {"year": 1923, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 8, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": [{"name": "Educational", "rank": 79, "isAdult": false}]}, {"id": 178304, "title": {"romaji": "Yakiguri", "english": null}, "format": "MUSIC", "description": "Music video for the song <i>Yakiguri</i> by Fusako Amachi and the NHK Tokyo Jidou Gasshoudan that was featured on NHK's Minna no Uta program. It is considered to be lost media.", "startDate": {"year": 1965, "month": 2}, "endDate": {"year": 1965, "month": 2}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 178305, "title": {"romaji": "Fruit Salad no Uta", "english": null}, "format": "MUSIC", "description": "Music video for the song <i>Fruit Salad no Uta</i> by Peggy Hayama that was featured on NHK's Minna no Uta program. It is considered to be lost media.", "startDate": {"year": 1964, "month": 10}, "endDate": {"year": 1964, "month": 10}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, 