{"data": {"Page": {"pageInfo": {"currentPage": 8, "hasNextPage": true}, "media": [{"id": 117086, "title": {"romaji": "Guraburu!", "english": "Grand Blues!"}, "format": "TV_SHORT", "description": "Set in the grand blue skies up above, the depths of darkness, elder sisters, knights, gentlemen, Vyrn lovers― all the colorful crew members will get to shine in a whole new light! \"Kept you waiting, huh? It's time for you to see our final forms!\" Join us and take flight to the world in the skies!<br>\n<br>\n(Source: Crunchyroll)", "startDate": {"year": 2020, "month": 10}, "endDate": {"year": 2020, "month": 12}, "season": "FALL", "seasonYear": 2020, "episodes": 12, "duration": 3, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": "#ぐらぶるっ", "genres": ["Comedy"], "tags": [{"name": "Episodic", "rank": 79, "isAdult": false}, {"name": "Ensemble Cast", "rank": 73, "isAdult": false}, {"name": "Chibi", "rank": 60, "isAdult": false}, {"name": "Parody", "rank": 60, "isAdult": false}, {"name": "Magic", "rank": 50, "isAdult": false}, {"name": "Gods", "rank": 50, "isAdult": false}, {"name": "Idol", "rank": 40, "isAdult": false}]}, {"id": 117096, "title": {"romaji": "Asatir: Mirai no Mukashibanashi", "english": "Future Folktales"}, "format": "ONA", "description": "In 2050 Riyadh, a grandmother named Asma takes her cherished grandchildren on a whirlwind journey to the past, showcasing the heritage and history of the Arabian Peninsula through retellings of the region’s most beloved folktales. With the help of their robotic cat, Anis, the children learn that their modern-day dilemmas are no match for the words of wisdom passed from generation to generation through their grandmother’s fascinating stories.<br>\n<br>\n(Source: Sentai Filmworks)", "startDate": {"year": 2020, "month": 4}, "endDate": {"year": 2020, "month": 6}, "season": "SPRING", "seasonYear": 2020, "episodes": 13, "duration": 25, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Adventure"], "tags": [{"name": "Primarily Child Cast", "rank": 79, "isAdult": false}, {"name": "Historical", "rank": 79, "isAdult": false}, {"name": "Kids", "rank": 79, "isAdult": false}, {"name": "Ensemble Cast", "rank": 79, "isAdult": false}, {"name": "Episodic", "rank": 79, "isAdult": false}, {"name": "Female Protagonist", "rank": 79, "isAdult": false}, {"name": "Cyberpunk", "rank": 79, "isAdult": false}, {"name": "Classic Literature", "rank": 79, "isAdult": false}, {"name": "Foreign", "rank": 75, "isAdult": false}]}, {"id": 117150, "title": {"romaji": "GET UP! GET LIVE! #Geragera", "english": null}, "format": "TV_SHORT", "description": "Chibi shorts of the V.A.×2D Entertainer project <i>GET UP! GET LIVE!</i><br><br>The project's story centers on aspiring comedian entertainers who all gather at SSS, a talent agency for comedians. The story portrays the friction and jealousy in their rivaling careers, as well as their admiration towards industry veterans, their disappointments, and the obstacles to their success as they aspire to become the greatest entertainers in Japan and the world. <br><br>(Source: Anime News Network)", "startDate": {"year": 2020, "month": 7}, "endDate": {"year": 2020, "month": 9}, "season": "SUMMER", "seasonYear": 2020, "episodes": 10, "duration": 2, "countryOfOrigin": "JP", "source": "OTHER", "hashtag": "#ゲラゲラ", "genres": ["Comedy", "Drama", "Slice of Life"], "tags": [{"name": "Chibi", "rank": 60, "isAdult": false}, {"name": "Primarily Male Cast", "rank": 60, "isAdult": false}]}, {"id": 117280, "title": {"romaji": "Ooya-san to Boku", "english": null}, "format": "TV_SHORT", "description": null, "startDate": {"year": 2020, "month": 3}, "endDate": {"year": 2020, "month": 3}, "season": "WINTER", "seasonYear": 2020, "episodes": 5, "duration": 5, "countryOfOrigin": "JP", "source": "MANGA", "hashtag": null, "genres": ["Slice of Life"], "tags": [{"name": "Autobiographical", "rank": 20, "isAdult": false}]}, {"id": 117325, "title": {"romaji": "Puso Ni Comi: Okawari", "