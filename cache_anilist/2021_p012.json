"season": "SUMMER", "seasonYear": 2021, "episodes": 13, "duration": 5, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Horror", "Supernatural"], "tags": [{"name": "Youkai", "rank": 79, "isAdult": false}, {"name": "Ghost", "rank": 79, "isAdult": false}, {"name": "Episodic", "rank": 20, "isAdult": false}, {"name": "Animals", "rank": 20, "isAdult": false}, {"name": "Anthology", "rank": 20, "isAdult": false}]}, {"id": 135255, "title": {"romaji": "Princess Principal: Crown Handler - Chapter 1: BUSY EASY MONEY", "english": null}, "format": "OVA", "description": "An anime short included with the <i>Princess Principal: Crown Handler Chapter 1</i> Blu-ray release. <br>\n<br>\nDorothy and Chise have called the members of Team White Pidgeon to the natural history room, because Dorothy apparently has something she wants to discuss.<br> <br>\n(Source: Anime News Network)", "startDate": {"year": 2021, "month": 9}, "endDate": {"year": 2021, "month": 9}, "season": "SUMMER", "seasonYear": 2021, "episodes": 1, "duration": 6, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": "#pripri", "genres": [], "tags": [{"name": "Female Protagonist", "rank": 73, "isAdult": false}, {"name": "Primarily Female Cast", "rank": 73, "isAdult": false}]}, {"id": 135381, "title": {"romaji": "Blue Reflection Ray!", "english": null}, "format": "ONA", "description": "A spin-off of the TV anime, depicting  characters from <i>Blue Reflection Ray</i> in chibified form and exhibits their daily life that unfolds behind the main story. The series is posted on their official Twitter, and as well the DMM Picture YouTube Channel.", "startDate": {"year": 2021, "month": 4}, "endDate": {"year": 2021, "month": 9}, "season": "SPRING", "seasonYear": 2021, "episodes": 24, "duration": 1, "countryOfOrigin": "JP", "source": "VIDEO_GAME", "hashtag": "#ブルリフR #ぶるりふれいっ", "genres": ["Comedy", "Slice of Life"], "tags": [{"name": "Chibi", "rank": 79, "isAdult": false}, {"name": "Primarily Female Cast", "rank": 79, "isAdult": false}, {"name": "Female Protagonist", "rank": 20, "isAdult": false}]}, {"id": 135432, "title": {"romaji": "BRIGHT: Samurai Soul", "english": "Bright: Samurai Soul"}, "format": "ONA", "description": "In the time between the fall of the Shogunate and the rise of the Meiji era, a powerful bright light emitted from a wand brings an end to the long Shogunate period to avoid further bloodshed as Japan begins to shift toward a new era. Amid these circumstances, a one-eyed wandering ronin named Izou, who has lost his reason to live, and Raiden, an orc who detests murder and hopes to leave a life of thievery behind, separately meet a young elf girl named Sonya around the same time. Together, they go on a journey along the Tokaido road to bring her and the wand she holds safely to the land of the elves in the north. Standing in their path is the mysterious organization Inferni, which aims to obtain the wand and revive the Dark Lord, who intends to rule all of creation. Inferni also uses the new Meiji government in its attempt to steal the wand from Izou, Raiden and Sonya. Traveling along the Tokaido road from Kyoto to Yokohama, Izou and Raiden begin their journey to protect the wand.\n<br><br>\n(Source: Netflix)", "startDate": {"year": 2021, "month": 10}, "endDate": {"year": 2021, "month": 10}, "season": "FALL", "seasonYear": 2021, "episodes": 1, "duration": 80, "countryOfOrigin": "JP", "source": "LIVE_ACTION", "hashtag": null, "genres": ["Action", "Adventure", "Fantasy"], "tags": [{"name": "Samurai", "rank": 75, "isAdult": false}, {"name": "Full CGI", "rank": 70, "isAdult": false}, {"name": "Swordplay", "rank": 60, "isAdult": false}, {"name": "Elf", "rank": 50, "isAdult": false}, {"name": "Historical", "rank": 40, "isAdult": false}, {"name": "Gore", "rank": 40, "isAdult": false}, {"name": "Guns", "rank": 20, "isAdult": false}, {"name": "Goblin", "rank": 20, "isAdult": false}, {"name": "Centaur", "rank": 20, "isAdult": false}, {"name": "Urban Fantasy", "rank": 20, "isAdult": false}, {"name": "Oiran", "rank": 10, "isAdult": false}]}, {"id": 135538, "title": {"romaji": "Gradations", "english": "Gradations"}, "format": "MOVIE", "description": "One day a girl and a boy set off to reach their ideal place. However, the girl comes to realize that the place they had arrived was not what she had really wanted. As the scenery around them changes, they find their minds too exist in gradations. \n<br><br>\n(Source: Geidai Animation)", "startDate": {"year": 2021, "month": 3}, "endDate": {"year": 2021, "month": 3}, "season": null, "seasonYear": null, "episodes": 1, "duration": 8, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Psychological", "Slice of Life"], "tags": []}, {"id": 135571, "title": {"romaji": "Tie Jie Gang Bing", "english": null}, "format": "ONA", "description": "College graduate Mu Siyun submitted his resume and suddenly became the head of a space fleet, leading thousands of mecha girl soldiers to conquer the universe!\n<br><br>\n(Source: WeComics)", "startDate": {"year": 2021, "month": 2}, "endDate": {"year": 2021, "month": 4}, "season": null, "seasonYear": null, "episodes": 24, "duration": 7, "countryOfOrigin": "CN", "source": "MANGA", "hashtag": null, "genres": ["Adventure", "Sci-Fi"], "tags": [{"name": "Space", "rank": 79, "isAdult": false}, {"name": "Female Harem", "rank": 79, "isAdult": false}, {"name": "Male Protagonist", "rank": 79, "isAdult": false}, {"name": "Primarily Female Cast", "rank": 79, "isAdult": false}, {"name": "Anti-Hero", "rank": 79, "isAdult": false}, {"name": "Military", "rank": 79, "isAdult": false}, {"name": "War", "rank": 79, "isAdult": false}, {"name": "Super Power", "rank": 60, "isAdult": false}, {"name": "Aliens", "rank": 60, "isAdult": false}, {"name": "Cyborg", "rank": 60, "isAdult": false}, {"name": "Dystopian", "rank": 60, "isAdult": false}, {"name": "Gore", "rank": 60, "isAdult": false}, {"name": "Politics", "rank": 60, "isAdult": false}, {"nam