": {"year": 1984, "month": 4}, "endDate": {"year": 1984, "month": 4}, "season": null, "seasonYear": null, "episodes": 1, "duration": 2, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": [], "tags": []}, {"id": 103454, "title": {"romaji": "GHOST", "english": null}, "format": "MOVIE", "description": "I made this work because I wanted to try out the idea of floating images in midair that had come to me when making Thunder. The entire work was shot frame-by-frame with long exposures. I filmed this in the company dorm I was living in in the middle of the night after I had come home from work, and thought I might die from what had become my daily pattern of sleeping for two hours in the morning then going off to work.\n<br><br>\n(Source: Takashi Ito)", "startDate": {"year": 1984, "month": null}, "endDate": {"year": 1984, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 5, "countryOfOrigin": "JP", "source": "ORIGINAL", "hashtag": null, "genres": ["Horror"], "tags": [{"name": "No Dialogue", "rank": 84, "isAdult": false}, {"name": "Ghost", "rank": 66, "isAdult": false}]}, {"id": 103458, "title": {"romaji": "Henkei Sakuhin Dai 2-ban", "english": "Metamorphose Works No.2"}, "format": "MOVIE", "description": "Short film by Kurosaka Keita.", "startDate": {"year": 1984, "month": null}, "endDate": {"year": 1984, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 23, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": [], "tags": []}, {"id": 103459, "title": {"romaji": "Henkei Sakuhin Dai 1-ban", "english": "Metamorphose Works No.1"}, "format": "MOVIE", "description": "Short film by Kurosaka Keita.", "startDate": {"year": 1984, "month": null}, "endDate": {"year": 1984, "month": null}, "season": null, "seasonYear": null, "episodes": 1, "duration": 16, "countryOfOrigin": "JP", "source": null, "hashtag": null, "genres": [], "tags": []}, {"id": 103693, "title": {"romaji": "BROOTS", "englis